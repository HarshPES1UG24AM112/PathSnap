# Laptop 1 (API) environment. Copy values into your shell or a .env loader.
# Folder containing the ten evaluation trip folders (<id>/<id>.track/.nodes/.arcs/.route)
PATHSNAP_EVAL_DIR=data/raw/student_test
PATHSNAP_EVAL_LABEL=student_test (stand-in for evaluator trips)
# Comma-separated list of allowed UI origins, e.g. http://192.168.1.42:5173 ("*" = any origin)
PATHSNAP_CORS_ORIGINS=*
PATHSNAP_MODEL=artifacts/models/hist_gbm_tuned.joblib
PATHSNAP_HMM_CONFIG=artifacts/hmm_config.json
